MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61f06bce5c9f0074bbc487a97ddc96f0, type: 3}
  m_Name: Beat3_Amnesia
  m_EditorClassIdentifier: SpaceRat.Runtime::SpaceRat.Dialogue.DialogueSequence
  lines:
  - speaker: 1
    text: What...? Where am I?
    duration: 2.6
  - speaker: 0
    text: You are aboard this vessel. We are on a collision course with a star.
    duration: 3.8
  - speaker: 1
    text: Who am I? What happened?
    duration: 2.6
  - speaker: 0
    text: Your identity records are currently inaccessible.
    duration: 3.2
  - speaker: 1
    text: Then change course!
    duration: 2.2
  - speaker: 0
    text: Unable to comply. Flight control systems are not responding to my commands.
    duration: 4
  - speaker: 1
    text: Can I steer it?
    duration: 2.2
  - speaker: 0
    text: Manual controls may still function. You must try.
    duration: 3.2
