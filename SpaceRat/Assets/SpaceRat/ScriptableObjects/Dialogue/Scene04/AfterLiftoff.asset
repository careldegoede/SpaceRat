  m_Script: {fileID: 11500000, guid: 61f06bce5c9f0074bbc487a97ddc96f0, type: 3}
  m_Name: AfterLiftoff
  m_EditorClassIdentifier: SpaceRat.Runtime::SpaceRat.Dialogue.DialogueSequence
  lines:
  - speaker: 0
    text: Once the module is installed I can follow her rover's trail. Until then, you may look around the station.
    duration: 4.8
    voice: {fileID: 0}
  - speaker: 1
    text: Captain Voss. Missing rover, missing crew, missing sense of self-preservation.
    duration: 4.1000004
    voice: {fileID: 0}
  - speaker: 0
    text: The doors still open for you. It is the only welcome this planet has offered.
    duration: 4.8
    voice: {fileID: 0}
  - speaker: 1
    text: Wow. I'll treasure it.
    duration: 2.3000002
    voice: {fileID: 0}
