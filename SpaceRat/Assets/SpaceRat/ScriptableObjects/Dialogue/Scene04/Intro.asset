  m_Name: Intro
  m_EditorClassIdentifier: SpaceRat.Runtime::SpaceRat.Dialogue.DialogueSequence
  lines:
  - speaker: 0
    text: Navigation module secured. I am taking it to the ship. Do not do anything interesting.
    duration: 4.8
    voice: {fileID: 0}
  - speaker: 1
    text: Define interesting.
    duration: 1.7
    voice: {fileID: 0}
  - speaker: 0
    text: Anything that ends with me explaining why it was a bad idea.
    duration: 4.7000003
