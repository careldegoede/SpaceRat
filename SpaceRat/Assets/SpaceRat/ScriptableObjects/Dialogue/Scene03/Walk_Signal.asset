  m_Script: {fileID: 11500000, guid: 61f06bce5c9f0074bbc487a97ddc96f0, type: 3}
  m_Name: Walk_Signal
  m_EditorClassIdentifier: SpaceRat.Runtime::SpaceRat.Dialogue.DialogueSequence
  lines:
  - speaker: 0
    text: One more thing. The signal we followed. It originates from the station.
    duration: 4.7000003
    voice: {fileID: 8300000, guid: 59b000c4dc28b7a4bbe415d63420aebb, type: 3}
  - speaker: 1
    text: So we crash-landed next to the one thing calling us. Coincidence?
    duration: 4.4
    voice: {fileID: 8300000, guid: bb11950f48a2dd2478976f3053f4d83a, type: 3}
  - speaker: 0
    text: I am not programmed for suspicion.
    duration: 2.9
    voice: {fileID: 8300000, guid: a0212d485b414da47ae728681db984d7, type: 3}
  - speaker: 1
    text: Lucky for you, I am.
    duration: 2.6000001
    voice: {fileID: 8300000, guid: 8a51fac40a5817c488143114d1e111bf, type: 3}
