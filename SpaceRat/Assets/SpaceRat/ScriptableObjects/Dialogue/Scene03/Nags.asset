  m_Script: {fileID: 11500000, guid: 61f06bce5c9f0074bbc487a97ddc96f0, type: 3}
  m_Name: Nags
  m_EditorClassIdentifier: SpaceRat.Runtime::SpaceRat.Dialogue.DialogueSequence
  lines:
  - speaker: 0
    text: North-east. It is the direction you are not walking in.
    duration: 4.1000004
    voice: {fileID: 8300000, guid: 04347a35fe7da1646b4430e661d3320a, type: 3}
  - speaker: 0
    text: The compass is the round thing in the corner of your vision. It is there to help.
    duration: 4.8
    voice: {fileID: 8300000, guid: 68e7651f5d4290d4a86b89773dc463c7, type: 3}
  - speaker: 0
    text: The station is north-east. The ocean is not. Please choose the station.
    duration: 4.7000003
    voice: {fileID: 8300000, guid: b12469fd358287e42b25899eba9a713d, type: 3}
