  lines:
  - speaker: 0
    text: Comset link established. Can you hear me?
    duration: 3.2
    voice: {fileID: 8300000, guid: 52b62503985a74246a1c1f9dbfdc4c98, type: 3}
  - speaker: 1
    text: Loud and unfortunately clear.
    duration: 2.3000002
    voice: {fileID: 8300000, guid: 1a0f5f6ffe6f63143a9b60a1afe67fa9, type: 3}
  - speaker: 0
    text: The station is on your compass. Follow the orange blip. Over the ridge.
