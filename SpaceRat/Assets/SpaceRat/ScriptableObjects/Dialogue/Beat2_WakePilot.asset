  lines:
  - speaker: 0
    text: Pilot. Wake up.
    duration: 2.2
    voice: {fileID: 8300000, guid: 496059a61ef3e214f9ecc611485481fd, type: 3}
  - speaker: 0
    text: Pilot, respond. This is not a drill. I checked.
