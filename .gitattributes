* text=auto
*.cs text eol=crlf
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.meta text eol=lf
*.png binary
*.jpg binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary

# Terrain data is binary-serialized: never eol-convert or text-merge it.
*TerrainData.asset binary
